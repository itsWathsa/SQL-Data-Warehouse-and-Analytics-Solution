                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    CAST(s.record_id AS INT) AS record_id,
    CAST(s.player_id AS INT) AS player_id,
    CAST(s.kills AS TINYINT) AS kills,
    CAST(s.assists AS TINYINT) AS assists,
    CAST(s.deaths AS TINYINT) AS deaths,
    CAST(s.accuracy_percent AS DECIMAL(5,2)) AS accuracy_percent,
    CAST(s.reaction_time_ms AS DECIMAL(7,2)) AS reaction_time_ms,
    CAST(s.fatigue_index AS DECIMAL(4,2)) AS fatigue_index,
    CAST(s.performance_score AS DECIMAL(7,2)) AS performance_score,
    CAST(s.win_probability AS DECIMAL(4,2)) AS win_probability,
    CAST(s.match_outcome AS VARCHAR(20)) AS match_outcome,
    CAST(s.mvp_award AS BIT) AS mvp_award,
    CAST(s.match_date AS DATE) AS match_date,
    CAST(s.tournament_name AS VARCHAR(100)) AS tournament_name,
    CAST(s.map_played AS VARCHAR(100)) AS map_played,
    CAST(s.match_type AS VARCHAR(50)) AS match_type
FROM Stg_MatchPerformance s
WHERE s.record_id IS NOT NULL</property>
