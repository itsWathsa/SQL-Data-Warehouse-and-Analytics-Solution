                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    CAST(p.player_id AS INT) AS player_id,
    CAST(p.player_name AS VARCHAR(100)) AS player_name,
    CAST(p.player_role AS VARCHAR(50)) AS player_role,
    CAST(p.country AS VARCHAR(50)) AS country,
