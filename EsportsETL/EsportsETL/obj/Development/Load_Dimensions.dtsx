                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    CAST(map_played AS VARCHAR(100)) AS map_name,
    CAST(
        CASE 
            WHEN map_played IN ('Skyline','Neon City','Metro Chaos') THEN 'Urban'
            WHEN map_played IN ('Desert Storm','Dust Arena','Blood Canyon') THEN 'Desert'
            WHEN map_played = 'Frozen Base' THEN 'Arctic'
            ELSE 'Other'
        END AS VARCHAR(50)
    ) AS map_type,
    CAST(
        CASE 
            WHEN map_played IN ('Skyline','Neon City','Desert Storm','Blood Canyon') THEN 'Large'
            WHEN map_played IN ('Frozen Base','Volcano Ridge','Metro Chaos') THEN 'Medium'
            ELSE 'Small'
        END AS VARCHAR(20)
    ) AS map_size
FROM Stg_MatchPerformance
WHERE map_played IS NOT NULL 
AND map_played &lt;&gt; ''</property>
                <property
