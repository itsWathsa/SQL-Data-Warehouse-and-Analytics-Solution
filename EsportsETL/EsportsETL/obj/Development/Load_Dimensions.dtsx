    CAST(p.is_active AS BIT) AS is_active,
    CAST(t.team_name AS VARCHAR(100)) AS team_name,
    CAST(t.region AS VARCHAR(50)) AS region
FROM Stg_Players p
JOIN Stg_Teams t ON p.team_id = t.team_id</property>
