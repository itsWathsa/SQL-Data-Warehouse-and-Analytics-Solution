                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    ROW_NUMBER() OVER (ORDER BY tournament_name) AS tournament_id,
    tournament_name,
    game_title,
    region,
    CAST(prize_pool_usd AS INT) AS prize_pool_usd,
    CAST(start_date AS DATE) AS start_date,
    CAST(end_date AS DATE) AS end_date
FROM (
    SELECT DISTINCT 
        tournament_name,
        game_title,
        region,
        prize_pool_usd,
        start_date,
        end_date
    FROM Stg_Tournaments
) AS UniqueT</property>
